    "NSLocalNetworkUsageDescription" : {
      "comment" : "iOS permission prompt for local network access (Info.plist NSLocalNetworkUsageDescription). \"ABS+\" and \"Audiobookshelf\" are product names: do not translate",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل ABS+ بخادم Audiobookshelf الخاص بك، والذي قد يكون على شبكتك المحلية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ABS+ verbindet sich mit deinem Audiobookshelf-Server, der sich in deinem lokalen Netzwerk befinden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ABS+ connects to your Audiobookshelf server, which may be on your local network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ABS+ se conecta a tu servidor de Audiobookshelf, que puede estar en tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ABS+ se connecte à votre serveur Audiobookshelf, qui peut se trouver sur votre réseau local."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ABS+ आपके Audiobookshelf सर्वर से कनेक्ट होता है, जो आपके लोकल नेटवर्क पर हो सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
