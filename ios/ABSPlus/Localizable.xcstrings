    "Progress sharing with them stops on all titles. Their existing progress is not changed." : {
      "comment" : "Unlink alert message",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتوقف مشاركة التقدم معه في جميع العناوين، ولن يتغير تقدمه الحالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fortschritt wird dann für keinen Titel mehr geteilt. Der bisherige Fortschritt des Kontos bleibt unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progress sharing with them stops on all titles. Their existing progress is not changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dejará de compartir el progreso con esta cuenta en todos los títulos. Su progreso actual no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partage de progression avec ce compte s’arrête pour tous les titres. Sa progression actuelle n’est pas modifiée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनके साथ सभी टाइटल पर प्रोग्रेस शेयर करना बंद हो जाएगा। उनकी मौजूदा प्रोग्रेस नहीं बदलेगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berbagi progres dengan akun ini akan berhenti di semua judul. Progres mereka yang sudah ada tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La condivisione dell’avanzamento con questo account si interromperà su tutti i titoli. Il suo avanzamento attuale non verrà modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのタイトルで進捗の共有が停止します。相手の現在の進捗は変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 타이틀에서 진행 상황 공유가 중단됩니다. 상대방의 기존 진행 상황은 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het delen van voortgang stopt voor alle titels. Hun bestaande voortgang blijft ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnianie postępu temu kontu zostanie wyłączone we wszystkich tytułach. Dotychczasowy postęp tego konta się nie zmieni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O compartilhamento de progresso com essa conta será interrompido em todos os títulos. O progresso atual dela não será alterado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partilha de progresso com esta conta termina em todos os títulos. O progresso existente da conta não é alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмен прогрессом с этим аккаунтом прекратится для всех книг и подкастов. Его текущий прогресс не изменится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förloppsdelningen med kontot upphör för alla titlar. Kontots befintliga förlopp ändras inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแชร์ความคืบหน้ากับบัญชีนี้จะหยุดในทุกรายการ แต่ความคืบหน้าที่มีอยู่ของบัญชีนั้นจะไม่เปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hesapla ilerleme paylaşımı tüm içeriklerde durur. Hesabın mevcut ilerlemesi değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обмін прогресом із цим акаунтом припиниться для всіх книжок і подкастів. Його поточний прогрес не зміниться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc chia sẻ tiến độ với tài khoản này sẽ dừng ở tất cả các tựa. Tiến độ hiện có của họ không bị thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有作品都将停止与其共享进度，对方现有的进度不会改变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有作品都將停止與對方共享進度，對方現有的進度不會變更。"
          }
        }
      }
    },
