{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ — %@" : {
      "comment" : "Resume choice button: %1$@ = account name (or \"You\"), %2$@ = position as h:mm:ss. Pure data.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@"
          }
        }
      },
      "shouldTranslate" : false
    },
    "%@. Tap Retry to continue." : {
      "comment" : "Download error after automatic retries; %@ = reason (e.g. HTTP 404). \"Retry\" is the label of the Retry button",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. اضغط على «إعادة المحاولة» للمتابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tippe auf „Wiederholen“, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tap Retry to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Toca Reintentar para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Touchez Réessayer pour continuer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। जारी रखने के लिए “फिर से कोशिश करें” पर टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Ketuk Coba lagi untuk melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tocca Riprova per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。「再試行」をタップして続行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 계속하려면 ‘다시 시도’를 탭하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tik op Opnieuw om door te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Dotknij „Ponów”, aby kontynuować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Toque em “Tentar novamente” para continuar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Toque em «Tentar novamente» para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Нажмите «Повторить», чтобы продолжить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tryck på Försök igen för att fortsätta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ แตะ “ลองอีกครั้ง” เพื่อดำเนินการต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Devam etmek için “Tekrar dene”ye dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Торкніться «Повторити», щоб продовжити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Nhấn Thử lại để tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。点按“重试”以继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。點一下「重試」即可繼續。"
          }
        }
      }
    },
