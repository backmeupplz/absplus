    "Swipe left to remove a download. Nothing is deleted on the server." : {
      "comment" : "Downloads list footer",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب أي تنزيل لإزالته. لن يُحذف أي شيء من الخادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische nach links, um einen Download zu entfernen. Auf dem Server wird nichts gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe left to remove a download. Nothing is deleted on the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia la izquierda para eliminar una descarga. No se borra nada del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la gauche pour supprimer un téléchargement. Rien n’est supprimé sur le serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड हटाने के लिए उसे बाईं ओर स्वाइप करें। सर्वर से कुछ भी नहीं मिटाया जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser ke kiri untuk menghapus unduhan. Tidak ada yang dihapus di server."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso sinistra per rimuovere un download. Sul server non verrà eliminato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左にスワイプするとダウンロードを削除できます。サーバー上のデータは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽으로 쓸어 넘기면 다운로드를 삭제할 수 있습니다. 서버에서는 아무것도 삭제되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar links om een download te verwijderen. Op de server wordt niets verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń w lewo, aby usunąć pobraną kopię. Nic nie zostanie usunięte z serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a esquerda para remover um download. Nada será excluído do servidor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a esquerda para remover uma transferência. Nada é eliminado no servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните влево, чтобы удалить скачанную копию. На сервере ничего не удалится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep åt vänster för att ta bort en nedladdning. Inget raderas på servern."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปัดไปทางซ้ายเพื่อลบไฟล์ดาวน์โหลด จะไม่มีการลบสิ่งใดบนเซิร์ฟเวอร์"
