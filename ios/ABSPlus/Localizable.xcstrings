    "Link another account on this server to keep your progress on this title in sync with it." : {
      "comment" : "Share sheet footer when no accounts are linked",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اربط حسابًا آخر على هذا الخادم لمزامنة تقدمك في هذا العنوان معه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verknüpfe ein weiteres Konto auf diesem Server, um deinen Fortschritt bei diesem Titel damit synchron zu halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link another account on this server to keep your progress on this title in sync with it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincula otra cuenta de este servidor para mantener tu progreso en este título sincronizado con ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associez un autre compte de ce serveur pour synchroniser avec lui votre progression sur ce titre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस टाइटल की प्रोग्रेस सिंक में रखने के लिए इस सर्वर पर कोई दूसरा खाता लिंक करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautkan akun lain di server ini agar progres Anda untuk judul ini tetap sinkron dengan akun tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega un altro account di questo server per mantenere sincronizzato con esso il tuo avanzamento su questo titolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーの別のアカウントを連携すると、このタイトルの進捗をそのアカウントと同期できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서버의 다른 계정을 연결하면 이 타이틀의 진행 상황을 해당 계정과 동기화할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel nog een account op deze server om je voortgang voor deze titel ermee synchroon te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz inne konto na tym serwerze, aby synchronizować z nim postęp w tym tytule."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincule outra conta deste servidor para manter seu progresso neste título sincronizado com ela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associe outra conta deste servidor para manter o progresso deste título sincronizado com ela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привяжите другой аккаунт на этом сервере, чтобы синхронизировать с ним прогресс по этой книге или подкасту."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Länka ett annat konto på den här servern för att hålla ditt förlopp för den här titeln synkat med det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลิงก์บัญชีอื่นบนเซิร์ฟเวอร์นี้เพื่อซิงค์ความคืบหน้าของคุณในรายการนี้กับบัญชีนั้น"
