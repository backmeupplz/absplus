        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir indirmeyi kaldırmak için sola kaydırın. Sunucuda hiçbir şey silinmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведіть уліво, щоб видалити завантаження. На сервері нічого не буде видалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt sang trái để xóa bản tải xuống. Không có gì bị xóa trên máy chủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
