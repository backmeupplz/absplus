    "Playback could not authenticate. Sign in or retry playback." : {
      "comment" : "Player error when no access token is available for streaming",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت المصادقة لبدء التشغيل. سجّل الدخول أو أعد محاولة التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabe nicht autorisiert. Melde dich an oder versuch es noch mal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback could not authenticate. Sign in or retry playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo autenticar la reproducción. Inicia sesión o reintenta la reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec d’authentification pour la lecture. Connectez-vous ou relancez la lecture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेबैक के लिए पुष्टि नहीं हो सकी। साइन इन करें या प्लेबैक फिर से आज़माएं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemutaran gagal diautentikasi. Masuk atau coba putar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autenticazione non riuscita per la riproduzione. Accedi o riprova la riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生時の認証に失敗しました。ログインするか、再生を再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생 인증에 실패했습니다. 로그인하거나 재생을 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspelen niet geautoriseerd. Log in of probeer opnieuw af te spelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się uwierzytelnić odtwarzania. Zaloguj się lub ponów odtwarzanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível autenticar a reprodução. Faça login ou tente reproduzir novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível autenticar a reprodução. Inicie sessão ou tente reproduzir novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось авторизоваться для воспроизведения. Войдите или повторите воспроизведение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppspelningen kunde inte autentiseras. Logga in eller försök spela igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืนยันตัวตนเพื่อเล่นไม่สำเร็จ โปรดลงชื่อเข้าใช้หรือลองเล่นอีกครั้ง"
